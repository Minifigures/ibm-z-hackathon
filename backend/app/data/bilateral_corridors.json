{
  "_meta": {
    "purpose": "Bilateral air-corridor multipliers applied on top of the gravity OD matrix.",
    "rationale": "Pure population-x-distance gravity systematically under-predicts (a) colonial/linguistic corridors (ESP-MEX, PRT-BRA), (b) high-volume tourism (GBR-ESP, DEU-TUR), and (c) diaspora/finance hubs (CHN-SGP, IND-ARE). Following Chinazzi 2020 and the GLEAM framework, these are corrected with bilateral multipliers calibrated against published 2019 IATA top-international-pair passenger counts and qualitative diaspora ties.",
    "scale": "Multiplier on the gravity-output cell. 1.0 = no change; values > 1.0 amplify. Symmetric (applied to both directions).",
    "sources": [
      "IATA Annual Review 2019: top international country-pair passenger flows",
      "ICAO Air Transport Reporting Form A: cross-border passenger statistics",
      "Chinazzi et al. 2020 Science: GLEAM bilateral connectivity weights",
      "Du et al. 2022 Lancet RH Eur: Mpox 2022 import network"
    ]
  },
